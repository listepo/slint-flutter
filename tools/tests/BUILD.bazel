load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:packaging.bzl", "android_aar", "apple_xcframework")
load("//tools:packaging_test.bzl", "android_manifest_test", "build_framework_shell_test", "framework_plist_test")

package(default_visibility = ["//visibility:public"])

android_manifest_test(name = "android_manifest_test")

build_framework_shell_test(name = "build_framework_shell_test")

framework_plist_test(name = "framework_plist_test")

sh_test(
    name = "buildifier",
    srcs = ["//tools:buildifier_test.sh"],
    tags = ["local"],
)

build_test(
    name = "codegen_worker_build",
    targets = ["//tools:codegen_worker"],
)

build_test(
    name = "worker_srcs_build",
    targets = ["//slint_generator:worker_srcs"],
)

genrule(
    name = "fake_so_arm64",
    outs = ["fake/arm64/libslint_dart.so"],
    cmd = "mkdir -p $$(dirname $@) && printf 'fake-arm64' > $@",
)

genrule(
    name = "fake_so_x64",
    outs = ["fake/x86_64/libslint_dart.so"],
    cmd = "mkdir -p $$(dirname $@) && printf 'fake-x64' > $@",
)

filegroup(
    name = "fake_arm64",
    srcs = [":fake_so_arm64"],
)

filegroup(
    name = "fake_x64",
    srcs = [":fake_so_x64"],
)

android_aar(
    name = "test_aar",
    out = "test.aar",
    libs = {
        "arm64-v8a": ":fake_arm64",
        "x86_64": ":fake_x64",
    },
    version = "0.0.0-test",
)

sh_test(
    name = "android_aar",
    srcs = ["verify_aar.sh"],
    args = ["$(location :test_aar)"],
    data = [":test_aar"],
    tags = ["local"],
)

genrule(
    name = "fake_dylib_arm64",
    outs = ["fake/macos/arm64/libslint_dart.dylib"],
    cmd = "mkdir -p $$(dirname $@) && printf 'int slint_dart_placeholder;\\n' | $(CC) -shared -x c - -o $@ -arch arm64",
    target_compatible_with = ["@platforms//os:macos"],
    toolchains = ["@bazel_tools//tools/cpp:toolchain_type"],
)

genrule(
    name = "fake_dylib_x64",
    outs = ["fake/macos/x64/libslint_dart.dylib"],
    cmd = "mkdir -p $$(dirname $@) && printf 'int slint_dart_placeholder;\\n' | $(CC) -shared -x c - -o $@ -arch x86_64",
    target_compatible_with = ["@platforms//os:macos"],
    toolchains = ["@bazel_tools//tools/cpp:toolchain_type"],
)

filegroup(
    name = "fake_macos_arm64",
    srcs = [":fake_dylib_arm64"],
    target_compatible_with = ["@platforms//os:macos"],
)

filegroup(
    name = "fake_macos_x64",
    srcs = [":fake_dylib_x64"],
    target_compatible_with = ["@platforms//os:macos"],
)

apple_xcframework(
    name = "test_xcframework",
    out = "test.xcframework.zip",
    slices = {
        "macos": [
            ":fake_macos_arm64",
            ":fake_macos_x64",
        ],
    },
    target_compatible_with = ["@platforms//os:macos"],
    version = "0.0.0-test",
)

sh_test(
    name = "apple_xcframework",
    srcs = ["verify_xcframework.sh"],
    args = ["$(location :test_xcframework)"],
    data = [":test_xcframework"],
    tags = ["local"],
    target_compatible_with = ["@platforms//os:macos"],
)

test_suite(
    name = "tooling",
    tests = [
        ":android_aar",
        ":android_manifest_test",
        ":apple_xcframework",
        ":build_framework_shell_test",
        ":buildifier",
        ":codegen_worker_build",
        ":framework_plist_test",
        ":worker_srcs_build",
    ],
)
